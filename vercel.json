{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "css/**/*", "use": "@vercel/static" },
    { "src": "js/**/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "data/catalogo.json", "use": "@vercel/static" },
    {
      "src": "api/**/*.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["servidor.py", "data/catalogo.json"]
      }
    }
  ],
  "routes": [
    { "src": "/api/pdf/([A-Za-z0-9-]+)", "dest": "/api/ver-pdf.py?id=$1" },
    { "src": "/api/(.*)", "dest": "/api/$1.py" },
    { "src": "/admin-estoque", "dest": "/admin.html" },
    { "handle": "filesystem" }
  ]
}
