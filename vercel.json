{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["gru1"],
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "versao.json", "use": "@vercel/static" },
    { "src": "css/**/*", "use": "@vercel/static" },
    { "src": "js/**/*", "use": "@vercel/static" },
    { "src": "assets/**/*", "use": "@vercel/static" },
    { "src": "data/catalogo.json", "use": "@vercel/static" },
    {
      "src": "api/catalogo.py",
      "use": "@vercel/python",
      "config": {
        "includeFiles": ["servidor.py", "data/catalogo.json"]
      }
    },
    {
      "src": "api/orcamentos.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/enviar-orcamento-email.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/orcamento-pdf.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/ver-pdf.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/dashboard-estatisticas.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/registrar-acesso.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/login.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/logout.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/sessao.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/auditoria.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    },
    {
      "src": "api/admin/metricas-acesso.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["servidor.py"] }
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/admin-estoque",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/versao.json",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/((?!api/).*)",
      "has": [{ "type": "host", "value": { "eq": "gigaeletro.vercel.app" } }],
      "status": 301,
      "headers": { "Location": "https://gigaeletro.com.br/$1" }
    },
    {
      "src": "/(.*)",
      "has": [{ "type": "host", "value": { "eq": "www.gigaeletro.com.br" } }],
      "status": 301,
      "headers": { "Location": "https://gigaeletro.com.br/$1" }
    },
    { "src": "/api/pdf/([A-Za-z0-9-]+)", "dest": "/api/ver-pdf.py?id=$1" },
    { "src": "/api/equipe/funcionarios", "dest": "/api/auditoria.py?equipe=funcionarios" },
    { "src": "/api/equipe/log", "dest": "/api/auditoria.py?equipe=log" },
    { "src": "/api/equipe/resumo", "dest": "/api/auditoria.py?equipe=resumo" },
    { "src": "/api/orcamentos", "dest": "/api/orcamentos.py" },
    { "src": "/api/(.*)", "dest": "/api/$1.py" },
    { "src": "/admin-estoque", "dest": "/admin.html" },
    { "handle": "filesystem" }
  ]
}
